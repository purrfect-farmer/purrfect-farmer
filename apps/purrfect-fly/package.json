{
  "type": "module",
  "name": "purrfect-fly",
  "version": "1.0.0",
  "description": "Purrfect Farmer cloud server",
  "main": "app.js",
  "bin": {
    "fly": "./fly"
  },
  "scripts": {
    "test": "node --test test/lib/*.test.js",
    "fly": "node fly",
    "start": "fastify start -l info app.js",
    "dev": "fastify start -w -l info -P app.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:refresh": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/sensible": "^6.0.5",
    "@keyv/sqlite": "^4.0.8",
    "@purrfect/shared": "workspace:*",
    "axios": "^1.20.0",
    "base64url": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "croner": "^9.1.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.1.0",
    "globby": "^14.1.0",
    "grammy": "^1.46.0",
    "hpagent": "^1.2.0",
    "http-cookie-agent": "^7.0.4",
    "inquirer": "^12.11.1",
    "jsdom": "^26.1.0",
    "keyv": "^5.6.0",
    "node-gyp": "^12.4.0",
    "seedrandom": "^3.0.5",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "telegram": "^2.26.22",
    "tough-cookie": "^5.1.2",
    "tweetnacl": "^1.0.3"
  }
}
